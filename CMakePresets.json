{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (the newest Visual Studio installed, Release)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja-msvc-relwithdebinfo",
      "displayName": "Windows (Ninja, MSVC, RelWithDebInfo, for development with scripts/build.ps1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos",
      "displayName": "macOS (universal, Release)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux (Release)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ci-windows",
      "displayName": "Windows (Ninja, MSVC, Release, with sccache, for CI)",
      "inherits": "ninja-msvc-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "macOS (universal, Release, with sccache, for CI)",
      "inherits": "macos",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "Linux (Release, with sccache, for CI)",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "ninja-msvc-relwithdebinfo", "configurePreset": "ninja-msvc-relwithdebinfo" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "ci-windows", "configurePreset": "ci-windows", "jobs": 4 },
    { "name": "ci-macos", "configurePreset": "ci-macos", "jobs": 4 },
    { "name": "ci-linux", "configurePreset": "ci-linux", "jobs": 4 }
  ]
}
